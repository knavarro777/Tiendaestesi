@page "/clientes"
@rendermode InteractiveServer
@inject NavigationManager _navigator
@inject IRepositorioClientes _repositorio

<h3>Clientes</h3>

<div class="row mb-3">
    <div class="col-md-6">
        <div class="input-group">
            <input type="text" class="form-control" placeholder="Buscar por nombre, correo o teléfono"
                   @bind="_filtroBusqueda" @bind:event="oninput" />
            <button class="btn btn-outline-secondary" type="button" @onclick="AplicarFiltro">
                <i class="bi bi-search"></i> Buscar
            </button>
        </div>
    </div>
    <div class="col-md-6 text-end">
        <a class="btn btn-success" href="clientes/nuevo">Agregar nuevo cliente</a>
    </div>
</div>

@if (_clientes == null)
{
    <div class="spinner-border" role="status">
        <span class="visually-hidden">Cargando...</span>
    </div>
}
else if (_clientesFiltrados.Count == 0)
{
    <div class="alert alert-warning">
        @if (string.IsNullOrEmpty(_filtroBusqueda))
        {
            <span>No hay clientes registrados</span>
        }
        else
        {
            <span>No se encontraron clientes con el criterio de búsqueda</span>
        }
    </div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Correo</th>
                <th>Teléfono</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var cliente in _clientesFiltrados)
            {
                <tr>
                    <td>@cliente.Nombre</td>
                    <td>@cliente.Correo</td>
                    <td>@FormatearTelefono(cliente.Telefono)</td>
                    <td>
                        <button class="btn btn-outline-secondary" title="Editar" @onclick="@(()=>Modificar(cliente.Id))">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-pencil" viewBox="0 0 16 16">
                                <path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325" />
                            </svg>
                        </button>
                        <button class="btn btn-outline-danger" title="Eliminar" @onclick="@(()=>Eliminar(cliente))">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-trash3" viewBox="0 0 16 16">
                                <path d="M6.5 1h3a.5.5 0 0 1 .5.5v1H6v-1a.5.5 0 0 1 .5-.5M11 2.5v-1A1.5 1.5 0 0 0 9.5 0h-3A1.5 1.5 0 0 0 5 1.5v1H1.5a.5.5 0 0 0 0 1h.538l.853 10.66A2 2 0 0 0 4.885 16h6.23a2 2 0 0 0 1.994-1.84l.853-10.66h.538a.5.5 0 0 0 0-1zm1.958 1-.846 10.58a1 1 0 0 1-.997.92h-6.23a1 1 0 0 1-.997-.92L3.042 3.5zm-7.487 1a.5.5 0 0 1 .528.47l.5 8.5a.5.5 0 0 1-.998.06L5 5.03a.5.5 0 0 1 .47-.53Zm5.058 0a.5.5 0 0 1 .47.53l-.5 8.5a.5.5 0 1 1-.998-.06l.5-8.5a.5.5 0 0 1 .528-.47M8 4.5a.5.5 0 0 1 .5.5v8.5a.5.5 0 0 1-1 0V5a.5.5 0 0 1 .5-.5" />
                            </svg>
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Cliente>? _clientes;
    private List<Cliente> _clientesFiltrados = new();
    private string _filtroBusqueda = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        _clientes = await _repositorio.GetAll();
        _clientesFiltrados = _clientes.ToList();
    }

    private void AplicarFiltro()
    {
        if (string.IsNullOrWhiteSpace(_filtroBusqueda))
        {
            _clientesFiltrados = _clientes!.ToList();
            return;
        }

        var terminoBusqueda = _filtroBusqueda.ToLower().Trim();
        _clientesFiltrados = _clientes!
            .Where(c =>
                (c.Nombre != null && c.Nombre.ToLower().Contains(terminoBusqueda)) ||
                (c.Correo != null && c.Correo.ToLower().Contains(terminoBusqueda)) ||
                (c.Telefono != null && c.Telefono.Contains(terminoBusqueda))
            )
            .ToList();
    }

    private async void Eliminar(Cliente cliente)
    {
        await _repositorio.Delete(cliente.Id);
        _clientes!.Remove(cliente);
        AplicarFiltro(); // Vuelve a aplicar el filtro después de eliminar
        StateHasChanged();
    }

    private void Modificar(int id)
    {
        _navigator.NavigateTo($"/clientes/editar/{id}");
    }

    private string FormatearTelefono(string? telefono)
    {
        if (string.IsNullOrEmpty(telefono) || telefono.Length != 10)
            return telefono ?? string.Empty;

        return $"({telefono.Substring(0, 3)}) {telefono.Substring(3, 3)}-{telefono.Substring(6)}";
    }
}